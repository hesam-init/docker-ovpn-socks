# Build mirrors for restricted networks: copy to .env (`cp .env.example .env`).
# Leave a value empty (or delete the line) to use Docker Hub and the Alpine CDN.
# No quotes: the Makefile includes this file directly.

# Registry host prefixed to the base image: <DOCKER_REGISTRY>/alpine:3.24
DOCKER_REGISTRY=docker.arvancloud.ir

# Alpine mirror root; the build appends /v<version>/main and /v<version>/community
APK_MIRROR=http://repo.iut.ac.ir/repo/alpine
